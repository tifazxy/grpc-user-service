{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard": {
            "format": "%(asctime)s - %(name)s -%(levelname)s -%(message)s"
        },
        "access": {
            "format": "%(asctime)s - %(levelname)s -%(client_addr)s -%(request_line)s - %(status_code)s"
        }
    },
    "handlers":{
        "console":{
            "class": "logging.StreamHandler",
            "formatter":"standard",
            "level":"INFO"
        },
        "file_handler":{
            "class":"logging.handlers.RotatingFileHandler",
            "formatter": "standard",
            "filename":"app.log",
            "maxBytes": 10485760,
            "backupCount":5,
            "level":"DEBUG"
        }
    },
    "loggers":{
        "uvicorn":{
            "handlers":["console"],
            "level":"INFO",
            "propagate": false
        },
        "uvicorn.access":{
            "handlers":["console"],
            "level":"WARNING",
            "propagate":false
        },
        "app_logger":{
            "handlers":["console", "file_handler"],
            "level":"DEBUG",
            "propagate":false
        }
    },
    "root":{
        "handlers":["console"],
        "level":"WARNING"
    }
}